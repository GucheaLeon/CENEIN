    %% =========================
    %% Catalogos
    %% =========================

    OS {
        bigint id PK
        string name UK
    }
    SEDE {
        bigint id PK
        string name UK
    }
    TREATMENTS {
        bigint id PK
        string name UK
    }
    PATIENT_STATE {
        bigint id PK
        string name UK
    }
    REPORT_TYPES {
        bigint id PK
        string name UK
    }
    DOCUMENTS_TYPE {
        bigint id PK
        string description UK
    }
    ROLES {
        bigint id PK
        string name UK
    }

    %% =========================
    %% Usuarios y autenticacion
    %% =========================

    USERS {
        bigint id PK
        string username UK
        string password_hash
        boolean is_admin
        timestamptz created_at
    }
    USER_ROLES {
        bigint user_rol_id PK
        bigint user_id FK
        bigint role_id FK
    }
    SESSIONS {
        string token PK
        bigint user_id FK
        timestamptz expires_at
        timestamptz created_at
    }
    USER_ACTIVITY_LOGS {
        bigint id PK
        bigint actor_user_id FK
        string actor_username
        string action_type
        string entity_type
        string entity_id
        string entity_label
        string details
        timestamptz created_at
    }
    login_rate_limits {
        string scope_key PK
        int failed_count
        timestamptz blocked_until
        timestamptz updated_at
    }

    %% =========================
    %% Pacientes y tratamientos
    %% =========================

    PATIENTS {
        string patient_id PK
        string first_name
        string last_name
        date birth_date
        string condition
        date last_visit
        date last_fisiatrico
        date last_fisiatrico_alta
        date last_fisiatrico_vencimiento
        date last_trabajo_social
        date last_trabajo_social_alta
        date last_trabajo_social_vencimiento
        string dni
        string cuit
        bigint os_id FK
        string affiliate_number
        string integracion_horario
        string diagnosis
        string father_tutor_name
        string father_tutor_phone
        string mother_tutor_name
        string mother_tutor_phone
        string address_street
        string address_number
        string address_neighborhood
        string address_floor
        string address_sector
        string school_name
        string school_grade
        string school_shift
        string car_years
        string ppi_years
        string acta_acuerdo_years
        string notes
        date authorization_expires_at
        boolean is_active
        boolean is_discharged
        bigint patient_state_id FK
        timestamptz discharged_at
        int parametro
        timestamptz created_at
    }
    PATIENTS_SEDE {
        bigint patient_sede_id PK
        string patient_id FK
        bigint sede_id FK
    }
    PATIENT_STATE_HISTORY {
        bigint id PK
        string patient_id FK
        bigint state_id FK
        string reason
        timestamptz created_at
    }
    AUTHORIZATIONS {
        bigint id PK
        string patient_id FK
        string status
        string rejection_reason
        date authorization_date
        timestamptz created_at
    }
    TREATMENT_PLANS {
        bigint id PK
        string patient_id FK
        date start_date
        date end_date
        string note
        timestamptz created_at
    }
    PATIENT_RECORDS {
        bigint id PK
        string patient_id FK
        bigint treatment_plan_id FK
        string shipment_type
        date shipment_date
        timestamptz created_at
    }
    TREATMENT_PLAN_ITEMS {
        bigint treatment_id PK, FK
        bigint treatment_plan_id PK, FK
    }
    PATIENT_DOCUMENTS {
        bigint id PK
        bigint patient_record_id FK
        bigint document_type FK
        string file_path
        timestamptz uploaded_at
    }
    PACIENT_REPORTS {
        bigint id PK
        string patient_id FK
        bigint report_type_id FK
        date report_date
        string report_type
        string content
        timestamptz created_at
    }
    PATIENT_TREATMENTS {
        bigint patient_treatment_id PK
        string patient_id FK
        bigint treatment_id FK
    }
    PATIENT_TURNS {
        string patient_id PK, FK
        bigint treatment_id PK, FK
        string day_of_week PK
        time time PK
    }
    PATIENT_TURNS_MONTHLY {
        string patient_id PK, FK
        bigint treatment_id PK, FK
        int month PK
        string day_of_week PK
        time time PK
    }
    PATIENT_TURNS_OVERRIDES {
        string patient_id PK, FK
        bigint treatment_id PK, FK
        date date PK
        time time PK
        boolean active
    }
    ATTENDANCES {
        bigint id PK
        string patient_id FK
        date date
        bigint treatment_id FK
        string note
        timestamptz created_at
    }
    PATIENT_REQUESTS {
        bigint patient_req_id PK
        string patient_id FK
        date start_date
        date end_date
        boolean apply_treatments
        timestamptz applied_at
        timestamptz created_at
        timestamptz updated_at
    }
    PATIENT_REQUEST_TREATMENTS {
        bigint patient_req_treatments PK
        bigint request_id FK
        bigint treatment_id FK
    }

    %% =========================
    %% Admision de pacientes
    %% =========================

    ADMISSIONS {
        bigint id PK
        string first_name
        string last_name
        date birth_date
        string dni
        string phone
        string address
        boolean tiene_obra_social
        string obra_social_nombre
        boolean tiene_cud
        string estado
        string patient_id FK
        timestamptz created_at
        timestamptz updated_at
    }
    ADMISSION_FISIATRIC_REVIEW {
        bigint id PK
        bigint admission_id FK
        date fecha_turno
        string resultado
        string devolucion
        string reviewed_by
        timestamptz created_at
    }
    ADMISSION_DOCUMENTS {
        bigint id PK
        bigint admission_id FK
        string dni_numero
        string numero_afiliado
        bytea carnet_pdf
