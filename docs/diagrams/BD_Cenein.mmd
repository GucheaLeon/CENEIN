        bigint id PK
        string patient_id FK
        bigint module_id FK
    }
    INVOICE_STATUS {
        bigint id PK
        string description
    }
    INVOICE_TYPE {
        bigint id PK
        string description
    }
    INVOICE {
        bigint id PK
        string patient_id FK
