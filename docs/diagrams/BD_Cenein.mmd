    %% =========================

    PATIENTS }o--|| OS : covers
    PATIENT_STATE ||--o{ PATIENTS : has
    PATIENTS ||--o{ PATIENTS_SEDE : serves
    PATIENTS_SEDE }o--|| SEDE : includes

    PATIENTS ||--o{ PATIENT_STATE_HISTORY : has
    PATIENT_STATE ||--o{ PATIENT_STATE_HISTORY : records
    PATIENTS ||--o{ AUTHORIZATIONS : has

    PATIENTS ||--o| PATIENT_ADDRESSES : tiene
    PATIENTS ||--o{ PATIENT_CONTACTS : tiene
    PATIENTS ||--o| PATIENT_EDUCATION : cursa
    PATIENTS ||--o{ PATIENT_ANNUAL_DOCS : gestiona

    PATIENTS ||--o{ TREATMENT_PLANS : has
    TREATMENT_PLANS ||--o{ TREATMENT_PLAN_ITEMS : includes
    TREATMENT_PLAN_ITEMS }o--|| TREATMENTS : contains
    TREATMENT_PLANS ||--o{ PATIENT_RECORDS : generates
    PATIENTS ||--o{ PATIENT_RECORDS : has
    PATIENT_RECORDS ||--o{ PATIENT_DOCUMENTS : contains
    PATIENT_DOCUMENTS }o--|| DOCUMENTS_TYPE : classifies

    PATIENTS ||--o{ PATIENT_TREATMENTS : has
    PATIENT_TREATMENTS }o--|| TREATMENTS : includes
    PATIENTS ||--o{ PATIENT_TURNS : schedules
    PATIENT_TURNS }o--|| TREATMENTS : applies_to
    PATIENTS ||--o{ PATIENT_TURNS_MONTHLY : schedules
    PATIENT_TURNS_MONTHLY }o--|| TREATMENTS : applies_to
    PATIENTS ||--o{ PATIENT_TURNS_OVERRIDES : overrides
    PATIENT_TURNS_OVERRIDES }o--|| TREATMENTS : applies_to
    PATIENTS ||--o{ ATTENDANCES : attends
    ATTENDANCES }o--|| TREATMENTS : belongs_to

    PATIENTS ||--o{ PACIENT_REPORTS : has
    PACIENT_REPORTS }o--|| REPORT_TYPES : categorizes

    PATIENTS ||--o{ PATIENT_REQUESTS : requests
    PATIENT_REQUESTS ||--o{ PATIENT_REQUEST_TREATMENTS : includes
    PATIENT_REQUEST_TREATMENTS }o--|| TREATMENTS : requested

    %% =========================
    %% Usuarios y autenticacion
    %% =========================

    USER_ROLES }o--|| ROLES : assigned
    USER_ROLES }o--|| USERS : has
    USERS ||--o{ SESSIONS : owns
    USERS ||--o{ USER_ACTIVITY_LOGS : generates

    %% =========================
